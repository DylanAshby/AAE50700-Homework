% Define the relevant values
a = 6628;
e = 0.01;
mu = 398600;

% Compute r and v magnitude at periapsis
p = a*(1-e^2)
r = p/(1+(e*cos(0)))
v = sqrt(((2*mu)/r)-(mu/a))

% Define the vector forms in RTN
rB = [r; 0; 0];
vB = [0; v; 0];

% Define the DCM
NB = [1 0 0; 0 cosd(45) -sind(45); 0 sind(45) cosd(45)]

% Then move rB and vB to ECI frame
rN = NB*rB
vN = NB*vB

